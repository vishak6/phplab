<?php
$servername = "localhost";
$username = "root";
$password = "root";
$dbname = "school";

$conn = new mysqli($servername, $username,$password, $dbname);
if ($conn->connect_error) {
    die("Connection Failed: " . $conn->connect_error);
}

echo "<h2>1. Display All Records</h2>";
$sql = "SELECT * FROM student";
$result = $conn->query($sql);
while ($row = $result->fetch_assoc()) {
    echo "Name: " . $row["Name"] . "<br>";
    echo "Roll No: " . $row["Rollno"] . "<br>";
    
    echo "City " . $row["City"] . "<br><br>";
}

echo "<hr>";
echo "<h2>2. Display Name & Marks Only</h2>";
$sql = "SELECT Name FROM student";
$result = $conn->query($sql);
while ($row = $result->fetch_assoc()) {
    echo "Name: " . $row["Name"] . "<br>"; 
}


echo "<hr>";
echo "<h2>3. Students Scoring More Than 80
Marks</h2>";
$sql = "SELECT * FROM student WHERE Marks > 80";
$result = $conn->query($sql);
while ($row = $result->fetch_assoc()) {
    echo "Name: " . $row["Name"] . "<br>";
    echo "Marks: " . $row["Marks"] . "<br><br>";
}


echo "<hr>";
echo "<h2>4. Records Sorted by Marks</h2>";
$sql = "SELECT * FROM student ORDER BY Marks DESC";
$result = $conn->query($sql);
while ($row = $result->fetch_assoc()) {
echo "Name: " . $row["Name"] . "<br>";
echo "Marks: " . $row["Marks"] . "<br>";
}

echo "<hr>";
echo "<h2>5. Total Number of Students</h2>";
$sql = "SELECT COUNT(*) AS TotalStudents FROM
student";
$result = $conn->query($sql);
$row = $result->fetch_assoc();
echo "Total Students: " . $row["TotalStudents"];

echo "<hr>";
echo "<h2>6. Highest Mark</h2>";
$sql = "SELECT MAX(Marks) AS HighestMark FROM
student";
$result = $conn->query($sql);
$row = $result->fetch_assoc();
echo "Highest Mark: " . $row["HighestMark"];

echo "<hr>";
echo "<h2>7. Average Marks</h2>";
$sql = "SELECT AVG(Marks) AS AverageMark FROM
student";
$result = $conn->query($sql);
$row = $result->fetch_assoc();
echo "Average Mark: " . $row["AverageMark"];
$conn->close();
?>
