<html>
<body>
    <form method ="get">
        1. String functions<br>
        2. Time Functions<br>
        3. Math Functions<br>
    Enter your choice<br><br>
    <input type="number" name="choice">
    <input type ="submit" value="submit">
    </form>
<?php
    $choice = $_GET["choice"]??"";
    switch($choice){
        case 1:
            $str = "Hello PHP";

            echo"Original String:$str";

            echo"Uppercase:".strtoupper($str)."<br>";
            echo"Reverse:".strrev($str)."<br>";
            echo"Lowercase:". strtolower($str)."<br>";
            echo"Trim Right:". rtrim($str)."<br>";
            echo"Trim Left:".ltrim($str)."<br>";
            echo"Repeat:".str_repeat($str,2)."<br>";
            echo"Replace:".str_replace("PHP","World",$str);
            break;
        case 2:
            date_default_timezone_get("Asia/Kolkata");

            echo"Date:".date("d-m-Y")."<br>";
            echo"Time:".date("h:i:s A");
            break;
        case 3:
            $n = -5.6;
            echo"Floor:".floor($n)."<br>";
            echo"Ceil:".ceil($n)."<br>";
            echo"Round:".round($n)."<br>";
            echo"Absolute:".abs($n)."<br>";
            echo"Square Root:".sqrt(25)."<br>";
            echo"Power:".pow(2,3)."<br>";
            echo"Maximum:".max(12,54,8,39,93)."<br>";
            echo"Minimum:".min(4,67,1,90)."<br>";
            break;
        default:
        echo"Invalid Choice";
    }
?>

