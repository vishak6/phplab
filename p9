<?php
$servername = "localhost";
$username = "root";
$password = "";
$dbname = "sriram";
$conn = new mysqli($servername, $username, $password, $dbname);
if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}
?>
<!DOCTYPE html>
<html>
<head>
    <title>Find Student Details</title>
</head>
<body>
<h2>Search Student</h2>
<form method="post">
    Enter Roll no:
    <input type="number" name="roll" required>
    <input type="submit" value="Search">
</form>
<?php
if ($_SERVER["REQUEST_METHOD"] == "POST" && isset($_POST["roll"])) {
    $id = $_POST["roll"];
    $sql = "SELECT * FROM table_srirsm  WHERE roll = $id ";
    $result = $conn->query($sql);
    if (!$result) {
        die("SQL Error: " . $conn->error);
    }
    if ($result->num_rows > 0) {
        while ($row = $result->fetch_assoc()) {
            echo "<h3>Student Details</h3>";
            echo "Name: " . $row["name"] . "<br>";
            echo "Rollno: " . $row["roll"] . "<br>";
            echo "Mobno: " . $row["phno"] . "<br>";
        }
    } else {
        echo "No student found";
    }
}

$conn->close();
?>
